# =====================================================================
# Cấu hình môi trường cho docker compose (đọc từ file .env ở thư mục gốc)
#
#   cp .env.example .env  ->  điền R2 credentials  ->  docker compose up --build
#
# File .env đã được gitignore — KHÔNG commit credentials lên git.
# =====================================================================

# ---------------------------------------------------------------------
# Cloudflare R2 — nơi lưu trữ file DUY NHẤT (CV / ảnh đại diện / logo)
#
# Lấy credentials:
#   Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
#   -> Create Account API Token -> Object Read & Write
#   -> copy Access Key ID + Secret Access Key
#
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# (ACCOUNT_ID lấy ở Account home -> Account ID)
# ---------------------------------------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Bucket ảnh công khai (avatar / logo) — có thể gắn Cloudflare CDN
R2_BUCKET_PUBLIC=viejob-public
# Bucket CV — KHÔNG public, tải qua presigned URL có hạn
R2_BUCKET_PRIVATE=viejob-private
# Subdomain r2.dev của bucket public (Settings -> Public Access -> Enable r2.dev).
# BẮT BUỘC — URL dạng https://pub-xxx.r2.dev/<key> không chứa tên bucket;
# nếu để trống, ảnh sẽ trả URL endpoint S3 cần chữ ký -> <img> bị 403.
R2_PUBLIC_BASE_URL=

# Thời hạn presigned URL (phút)
R2_PRESIGN_PUT_TTL_MINUTES=10
R2_PRESIGN_GET_TTL_MINUTES=5

# --- CORS cho R2 (bắt buộc khi browser PUT trực tiếp lên R2) ---
# Thêm rule trong Cloudflare Dashboard -> R2 -> bucket -> Settings -> CORS:
#   AllowedOrigins: http://localhost:5173, http://localhost:8000, https://<domain-cua-ban>
#   AllowedMethods: PUT, GET, HEAD
#   AllowedHeaders: Content-Type
#   ExposeHeaders: ETag
#
# Hoặc chạy 1 lần: backend/scripts/SetupR2Cors.java (cần token Admin Read & Write).
