{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "cd .. && husky install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "preview": "vite preview",
    "verify:toast": "vite build --ssr scripts/verify-toast.ts --outDir .tmp-verify --logLevel error && node .tmp-verify/verify-toast.js",
    "verify:integration": "vite build --ssr scripts/verify-integration.ts --outDir .tmp-verify --logLevel error && node .tmp-verify/verify-integration.js",
    "verify:e2e": "vite build --ssr scripts/verify-e2e.ts --outDir .tmp-verify --logLevel error && node .tmp-verify/verify-e2e.js",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "verify:full-app": "node scripts/verify-full-app.mjs",
    "verify:ui-fixes": "node scripts/verify-ui-fixes.mjs",
    "verify:reapply": "node scripts/verify-reapply.mjs",
    "verify:employer-chart": "node scripts/verify-employer-chart.mjs",
    "verify:realtime": "node scripts/verify-realtime-ws.mjs",
    "smoke:realtime": "node scripts/smoke-realtime-browser.mjs",
    "verify:review-two-way": "node scripts/verify-review-two-way.mjs",
    "smoke:review-two-way": "node scripts/smoke-review-two-way.mjs",
    "verify:files-storage": "node scripts/verify-files-storage.mjs",
    "smoke:files-upload": "node scripts/smoke-files-upload.mjs",
    "verify:cv-viewer": "node scripts/verify-cv-viewer.mjs",
    "smoke:cv-viewer": "node scripts/smoke-cv-viewer.mjs",
    "verify:cv-zoom": "node scripts/verify-cv-zoom.mjs",
    "verify:cv-quota": "node scripts/verify-cv-quota.mjs",
    "verify:logout": "node scripts/verify-logout.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify": "npm run verify:toast && npm run verify:integration && npm run verify:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-pdf": "^11.1.0",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  }
}
