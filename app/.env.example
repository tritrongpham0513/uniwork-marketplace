# =====================================================================
# Cấu hình môi trường cho FRONTEND (Vite)
#
#   cp .env.example .env   (file .env đã gitignore)
#
# File này CHỈ áp dụng cho `pnpm dev` chạy ngoài Docker.
# Khi chạy trong Docker, Vite proxy /api -> backend (vite.config.ts).
# =====================================================================

# Base URL của API.
#
# Rỗng (mặc định) = SAME-ORIGIN:
#   - dev (vite)      : Vite proxy /api -> http://localhost:8080
#   - prod (docker)   : nginx proxy /api -> backend:8080
#   - prod (Vercel)   : Vercel rewrite /api/* -> Render (vercel.json)
#
# Chỉ đặt khi API nằm ở domain KHÁC HẲN với app (ví dụ chạy `pnpm dev` ngoài
# Docker trong khi backend chạy ở port khác).
VITE_API_URL_DEV=

# ---------------------------------------------------------------------
# VITE_WS_URL — URL WebSocket thông báo realtime
#
# Rỗng (mặc định) = suy ra từ window.location.origin (đúng khi app và API
# cùng origin: docker/nginx, hoặc local Vite proxy).
#
# BẮT BUỘC khi frontend deploy trên Vercel và API trên Render:
#   Vercel rewrite KHÔNG nâng cấp được header `Upgrade` sang origin ngoài
#   -> WebSocket sẽ không kết nối được. Phải trỏ thẳng về Render:
#
#   VITE_WS_URL=wss://viejob-api.onrender.com
#
# Sau khi gắn custom domain cho API:
#   VITE_WS_URL=wss://api-job.viejoy.io.vn
#
# LƯU Ý: đây là biến BUILD-TIME (Vite inline lúc `pnpm build`).
# Đổi giá trị => phải redeploy Vercel.
# ---------------------------------------------------------------------
VITE_WS_URL=

# ---------------------------------------------------------------------
# Google OAuth2 (Google Identity Services)
#
# Client ID lấy ở Google Cloud Console -> APIs & Services -> Credentials.
# Authorized JavaScript origins: http://localhost:5173, https://<domain-app>
# ---------------------------------------------------------------------
VITE_CLIENT_ID_GOOGLE=
VITE_REDIRECT_URI_GOOGLE=
