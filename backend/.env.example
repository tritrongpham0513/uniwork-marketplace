# =====================================================================
# UniWork Marketplace - Environment Configuration Template
# Sao chép file này thành .env hoặc thiết lập trong môi trường máy chủ
# =====================================================================

# 1. Cơ sở dữ liệu MySQL
DB_URL=jdbc:mysql://localhost:3306/parttime_marketplace?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# 2. Bảo mật JSON Web Token (JWT)
# Khóa bí mật HMAC-SHA256 (tối thiểu 256 bits = 32 bytes hex/base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 3. Cấu hình gửi Mail qua Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
APP_MAIL_FROM=UniWork Marketplace <no-reply@uniwork.vn>

# 4. Xác thực Google OAuth2
# Client ID đăng ký trên Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 5. Đường dẫn gốc ứng dụng (dùng tạo liên kết xác thực email)
APP_BASE_URL=http://localhost:8080

# 6. Danh sách các Domain Frontend được phép gọi API (phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 7. Tài khoản Quản trị viên khởi tạo ban đầu (Tùy chọn - chỉ tạo khi được cấu hình)
ADMIN_INITIAL_EMAIL=admin@uniwork.vn
ADMIN_INITIAL_PASSWORD=admin123456

