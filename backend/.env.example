# =====================================================================
# UniWork Marketplace - Environment Configuration Template
# Sao chép file này thành .env hoặc thiết lập trong môi trường máy chủ
# =====================================================================

# 1. Cơ sở dữ liệu MySQL
DB_URL=jdbc:mysql://localhost:3306/parttime_marketplace?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# 2. Bảo mật JSON Web Token (JWT)
# Khóa bí mật HMAC-SHA256 (tối thiểu 256 bits = 32 bytes hex/base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 3. Cấu hình gửi Mail qua Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
APP_MAIL_FROM=UniWork Marketplace <no-reply@uniwork.vn>

# 4. Xác thực Google OAuth2
# Client ID đăng ký trên Google Cloud Console
GOOGLE_CLIENT_ID=453610447705-f8tsl8tu5psji76slhhupkj02o5m81uc.apps.googleusercontent.com

# 5. Đường dẫn gốc ứng dụng (dùng tạo liên kết xác thực email)
APP_BASE_URL=http://localhost:8080

# 6. Danh sách các Domain Frontend được phép gọi API (phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 7. Tài khoản Quản trị viên khởi tạo ban đầu (Tùy chọn - chỉ tạo khi được cấu hình)
ADMIN_INITIAL_EMAIL=admin@uniwork.vn
ADMIN_INITIAL_PASSWORD=admin123456

# =====================================================================
# 8. LƯU TRỮ FILE UPLOAD (CV / ảnh đại diện / logo) — CLOUDFLARE R2
#
# Hệ thống dùng R2 (S3-compatible) làm nơi lưu trữ DUY NHẤT.
# Free tier: 10 GB storage + egress miễn phí.
# File không nằm trong container → không mất khi restart / rebuild.
#
# Upload đi qua luồng presigned PUT: browser PUT thẳng lên R2,
# backend không nhận nội dung file.
# =====================================================================

# Endpoint dạng https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Access Key ID + Secret Access Key tạo trong Cloudflare Dashboard
# (R2 → Manage R2 API Tokens → Object Read & Write)
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Bucket ảnh công khai (avatar / logo) — có thể gắn Cloudflare CDN
R2_BUCKET_PUBLIC=viejob-public
# Bucket CV — KHÔNG public, tải qua presigned URL có hạn
R2_BUCKET_PRIVATE=viejob-private
# Domain CDN phục vụ bucket-public (rỗng → dùng endpoint R2 trực tiếp)
R2_PUBLIC_BASE_URL=
# Thời hạn presigned URL (phút)
R2_PRESIGN_PUT_TTL_MINUTES=10
R2_PRESIGN_GET_TTL_MINUTES=5

# --- CORS cho R2 (bắt buộc khi browser PUT trực tiếp lên R2) ---
# Thêm rule trong Cloudflare Dashboard → R2 → bucket → Settings → CORS:
#   AllowedOrigins: http://localhost:5173, http://localhost:8000, https://<domain-cua-ban>
#   AllowedMethods: PUT, GET, HEAD
#   AllowedHeaders: Content-Type
#   ExposeHeaders: ETag

